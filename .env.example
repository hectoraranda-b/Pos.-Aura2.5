# ==============================================================================
# AURA POS ENTERPRISE - VARIABLES DE ENTORNO Y CONFIGURACIÓN DE PRODUCCIÓN
# Desarrollado por ISC Héctor Raúl Antonio Aranda Barroso - Merasystems Corp
# ==============================================================================

# 1. BASE DE DATOS (OPCIONAL)
# Por defecto Aura POS utiliza almacenamiento embebido seguro de alta velocidad (JSON / SQLite).
# Si se utiliza PostgreSQL para servidores dedicados, especifique la URL de conexión:
DATABASE_URL=""

# 2. GOOGLE DRIVE API OAUTH 2.0 (RESPALDOS EN LA NUBE)
# Obtenga estas credenciales en https://console.cloud.google.com/
# Configure el URI de redirección autorizado: http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""

# 3. DROPBOX BUSINESS API OAUTH 2.0 (RESPALDOS EN LA NUBE)
# Obtenga estas credenciales en https://www.dropbox.com/developers/apps
# Configure el Redirect URI autorizado: http://localhost:3000/api/auth/dropbox/callback
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""

# 4. CLAVE DE CIFRADO DE RESPALDOS AES-256 (OPCIONAL)
# Clave personalizada para cifrar los archivos .aura.enc generados al cierre de turno.
# Si se omite, se genera automáticamente una clave vinculada al Machine ID del equipo.
BACKUP_ENCRYPTION_KEY=""

# 5. PUERTO DE RED LOCAL
PORT=3000
