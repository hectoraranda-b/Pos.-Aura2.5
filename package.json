{
  "name": "aura-pos-enterprise",
  "version": "2.5.0",
  "description": "Aura POS Enterprise Edition - Sistema de Punto de Venta Profesional",
  "main": "electron-main.js",
  "author": "ISC Héctor Raúl Antonio Aranda Barroso <hector.aranda.b@gmail.com> (Merasystems)",
  "company": "Merasystems Corp",
  "license": "Commercial",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "clean:data": "node scripts/clean_seed.js",
    "seed": "node scripts/clean_seed.js",
    "electron": "electron .",
    "electron:dev": "electron .",
    "build:win": "electron-builder --win nsis portable",
    "build:linux": "electron-builder --linux deb AppImage",
    "build:deb": "electron-builder --linux deb",
    "build:all": "electron-builder -wl",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "retail",
    "inventory",
    "express",
    "bootstrap5",
    "electron",
    "debian",
    "chromeos",
    "windows"
  ],
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.merasystems.aurapos",
    "productName": "Aura POS Enterprise",
    "copyright": "Copyright © 2026 Merasystems Corp - ISC Héctor Raúl Antonio Aranda Barroso",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "package.json",
      ".env.example",
      "public/**/*",
      "data/**/*",
      "!test_*.js",
      "!CloudSync_*/**/*",
      "!AuraPOS_Respaldo/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura POS Enterprise"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office;Utility;Finance;",
      "maintainer": "ISC Héctor Raúl Antonio Aranda Barroso <hector.aranda.b@gmail.com>",
      "synopsis": "Sistema de Punto de Venta Profesional Enterprise para Retail y Comercios",
      "description": "Aura POS Enterprise Edition con soporte para múltiples terminales, respaldos automáticos en Google Drive y Dropbox, soporte para cajón de dinero e impresoras térmicas ESC/POS."
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional",
      "depends": [
        "gconf2",
        "gconf-service",
        "libnotify4",
        "libappindicator1",
        "libxtst6",
        "libnss3"
      ]
    }
  }
}
